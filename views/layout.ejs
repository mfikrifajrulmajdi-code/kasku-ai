<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="KasKu AI - Kelola koneksi dan pengaturan bot keuangan Anda">
  <title>KasKu AI — <%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-header">
      <div class="logo">
        <span class="logo-icon">🤖</span>
        <span class="logo-text">KasKu AI</span>
      </div>
    </div>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="nav-item <%= page === 'dashboard' ? 'active' : '' %>">
        <span class="nav-icon">📊</span>
        <span class="nav-label">Dashboard</span>
      </a>
      <a href="/settings" class="nav-item <%= page === 'settings' ? 'active' : '' %>">
        <span class="nav-icon">⚙️</span>
        <span class="nav-label">Pengaturan</span>
      </a>
      <a href="/broadcast" class="nav-item <%= page === 'broadcast' ? 'active' : '' %>">
        <span class="nav-icon">📢</span>
        <span class="nav-label">Broadcast Massal</span>
      </a>
      <a href="/sandbox" class="nav-item <%= page === 'sandbox' ? 'active' : '' %>">
        <span class="nav-icon">🧪</span>
        <span class="nav-label">AI Sandbox</span>
      </a>
      <a href="/evaluator" class="nav-item <%= page === 'evaluator' ? 'active' : '' %>">
        <span class="nav-icon">🧑‍🔬</span>
        <span class="nav-label">Evaluator QA</span>
      </a>
      <a href="/admin/tenants" class="nav-item <%= page === 'tenants' ? 'active' : '' %>">
        <span class="nav-icon">🏢</span>
        <span class="nav-label">Multi-Tenant SaaS</span>
      </a>
    </nav>

    <div class="sidebar-footer">
      <div class="status-badge" id="sidebar-status">
        <span class="status-dot disconnected"></span>
        <span class="status-label">Terputus</span>
      </div>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="main-content">
    <header class="top-bar">
      <h1 class="page-title"><%= title %></h1>
      <div class="top-bar-actions">
        <span class="clock" id="live-clock"></span>
      </div>
    </header>
    <div class="content-area">
      <%- body %>
    </div>
  </main>

  <!-- Toast Container -->
  <div id="toast-container"></div>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
