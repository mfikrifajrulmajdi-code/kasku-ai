<style>
  .sandbox-container {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 20px;
    height: calc(100vh - 120px);
  }

  /* Sidebar Panel */
  .sb-panel {
    background: var(--card-bg, #1a1a2e);
    border-radius: 16px;
    padding: 20px;
    border: 1px solid rgba(255,255,255,0.06);
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow-y: auto;
  }
  .sb-panel h3 { margin: 0; font-size: 14px; color: #888; text-transform: uppercase; letter-spacing: 1px; }

  /* Persona Selector */
  .persona-grid { display: flex; flex-direction: column; gap: 8px; }
  .persona-btn {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 16px; border-radius: 12px; cursor: pointer;
    border: 2px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.03);
    color: #ccc; transition: all 0.2s;
  }
  .persona-btn:hover { border-color: rgba(99,102,241,0.4); background: rgba(99,102,241,0.08); }
  .persona-btn.active { border-color: #6366f1; background: rgba(99,102,241,0.15); color: #fff; }
  .persona-btn .p-icon { font-size: 24px; }
  .persona-btn .p-info { display: flex; flex-direction: column; }
  .persona-btn .p-name { font-weight: 600; font-size: 14px; }
  .persona-btn .p-desc { font-size: 11px; color: #888; }

  /* Agent Stats */
  .agent-list { display: flex; flex-direction: column; gap: 6px; }
  .agent-item {
    display: flex; justify-content: space-between; align-items: center;
    padding: 8px 12px; border-radius: 8px; background: rgba(255,255,255,0.03);
    font-size: 13px; color: #aaa;
  }
  .agent-item .a-name { display: flex; align-items: center; gap: 6px; }
  .agent-item .a-badge {
    background: rgba(99,102,241,0.2); color: #818cf8; padding: 2px 8px;
    border-radius: 20px; font-size: 11px;
  }

  /* Chat Area */
  .chat-area {
    display: flex; flex-direction: column;
    background: var(--card-bg, #1a1a2e); border-radius: 16px;
    border: 1px solid rgba(255,255,255,0.06); overflow: hidden;
  }
  .chat-header {
    padding: 16px 20px; border-bottom: 1px solid rgba(255,255,255,0.06);
    display: flex; justify-content: space-between; align-items: center;
  }
  .chat-header h2 { margin: 0; font-size: 16px; color: #fff; }
  .chat-header .ch-badge {
    background: rgba(52,211,153,0.15); color: #34d399; padding: 4px 12px;
    border-radius: 20px; font-size: 12px;
  }

  .chat-messages {
    flex: 1; overflow-y: auto; padding: 20px; display: flex;
    flex-direction: column; gap: 16px;
  }

  .msg-row { display: flex; gap: 10px; max-width: 85%; }
  .msg-row.user { align-self: flex-end; flex-direction: row-reverse; }
  .msg-row.bot { align-self: flex-start; }

  .msg-avatar {
    width: 36px; height: 36px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; flex-shrink: 0;
  }
  .msg-row.user .msg-avatar { background: rgba(99,102,241,0.2); }
  .msg-row.bot .msg-avatar { background: rgba(52,211,153,0.2); }

  .msg-content { display: flex; flex-direction: column; gap: 4px; }
  .msg-bubble {
    padding: 12px 16px; border-radius: 16px; font-size: 14px;
    line-height: 1.5; white-space: pre-wrap; word-break: break-word;
  }
  .msg-row.user .msg-bubble { background: rgba(99,102,241,0.2); color: #c7d2fe; border-bottom-right-radius: 4px; }
  .msg-row.bot .msg-bubble { background: rgba(255,255,255,0.06); color: #e0e0e0; border-bottom-left-radius: 4px; }

  .msg-meta {
    font-size: 11px; color: #666; display: flex; gap: 8px; flex-wrap: wrap;
  }
  .msg-row.user .msg-meta { justify-content: flex-end; }
  .meta-tag {
    background: rgba(255,255,255,0.05); padding: 2px 8px;
    border-radius: 10px; display: inline-flex; align-items: center; gap: 3px;
  }
  .meta-tag.intent { background: rgba(251,191,36,0.15); color: #fbbf24; }
  .meta-tag.sentiment { background: rgba(244,114,182,0.15); color: #f472b6; }
  .meta-tag.urgency { background: rgba(248,113,113,0.15); color: #f87171; }
  .meta-tag.time { background: rgba(96,165,250,0.15); color: #60a5fa; }
  .meta-tag.agent { background: rgba(52,211,153,0.15); color: #34d399; }

  /* Typing indicator */
  .typing-indicator { display: none; align-self: flex-start; padding: 8px 16px; }
  .typing-indicator.active { display: flex; }
  .typing-indicator .dots { display: flex; gap: 4px; align-items: center; }
  .typing-indicator .dots span {
    width: 8px; height: 8px; border-radius: 50%; background: #6366f1;
    animation: blink 1.4s infinite both;
  }
  .typing-indicator .dots span:nth-child(2) { animation-delay: 0.2s; }
  .typing-indicator .dots span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes blink { 0%,80%,100% { opacity: 0.3; } 40% { opacity: 1; } }

  /* Input area */
  .chat-input-area {
    padding: 16px 20px; border-top: 1px solid rgba(255,255,255,0.06);
    display: flex; gap: 10px; align-items: center;
  }
  .chat-input {
    flex: 1; padding: 12px 16px; border-radius: 12px;
    background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);
    color: #fff; font-size: 14px; outline: none; font-family: 'Inter', sans-serif;
  }
  .chat-input:focus { border-color: #6366f1; }
  .chat-input::placeholder { color: #555; }

  .btn-send, .btn-reset {
    padding: 12px 20px; border-radius: 12px; border: none;
    cursor: pointer; font-size: 14px; font-weight: 600;
    transition: all 0.2s;
  }
  .btn-send { background: #6366f1; color: #fff; }
  .btn-send:hover { background: #4f46e5; }
  .btn-send:disabled { opacity: 0.5; cursor: not-allowed; }
  .btn-reset { background: rgba(239,68,68,0.15); color: #ef4444; }
  .btn-reset:hover { background: rgba(239,68,68,0.25); }

  /* Quick test buttons */
  .quick-tests { display: flex; flex-wrap: wrap; gap: 6px; }
  .qt-btn {
    padding: 6px 12px; border-radius: 20px; font-size: 11px;
    background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08);
    color: #aaa; cursor: pointer; transition: all 0.15s;
  }
  .qt-btn:hover { background: rgba(99,102,241,0.15); color: #a5b4fc; border-color: rgba(99,102,241,0.3); }

  /* Welcome screen */
  .welcome-screen {
    flex: 1; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 12px; color: #555;
  }
  .welcome-screen .emoji { font-size: 48px; }
  .welcome-screen h3 { margin: 0; color: #888; }
  .welcome-screen p { margin: 0; font-size: 13px; text-align: center; max-width: 320px; }
</style>

<div class="sandbox-container">
  <!-- Left Panel -->
  <div class="sb-panel">
    <div>
      <h3>🎭 Persona</h3>
      <p style="font-size:12px; color:#666; margin:4px 0 10px;">Pilih peran untuk simulasi</p>
      <div class="persona-grid">
        <div class="persona-btn active" data-persona="customer" onclick="setPersona(this)">
          <span class="p-icon">👤</span>
          <div class="p-info">
            <span class="p-name">Pelanggan</span>
            <span class="p-desc">Calon pembeli / pelanggan baru</span>
          </div>
        </div>
        <div class="persona-btn" data-persona="vendor" onclick="setPersona(this)">
          <span class="p-icon">🏭</span>
          <div class="p-info">
            <span class="p-name">Vendor / Supplier</span>
            <span class="p-desc">Pemasok bahan baku</span>
          </div>
        </div>
        <div class="persona-btn" data-persona="owner" onclick="setPersona(this)">
          <span class="p-icon">👔</span>
          <div class="p-info">
            <span class="p-name">Owner / Bos</span>
            <span class="p-desc">Perintah eksekutif & keuangan</span>
          </div>
        </div>
      </div>
    </div>

    <div>
      <h3>⚡ Quick Test</h3>
      <div class="quick-tests">
        <button class="qt-btn" onclick="quickSend('Halo kak, ada sepatu untuk kerja?')">Tanya Produk</button>
        <button class="qt-btn" onclick="quickSend('Pesan 1 pasang ukuran 42, kirim ke Jl Melati 5 Jakarta')">Checkout</button>
        <button class="qt-btn" onclick="quickSend('Barang saya kok belum sampai! Kecewa banget!')">Komplain</button>
        <button class="qt-btn" onclick="quickSend('Ada lowongan kerja gak min?')">Tanya Loker</button>
        <button class="qt-btn" onclick="quickSend('Aplikasi saya error pas login')">Tech Support</button>
        <button class="qt-btn" onclick="setPersona(document.querySelector('[data-persona=owner]')); quickSend('makan siang 50rb bca')">💰 Catat Uang</button>
        <button class="qt-btn" onclick="setPersona(document.querySelector('[data-persona=owner]')); quickSend('Buatin draft promo diskon 50% akhir bulan')">📢 Promo</button>
        <button class="qt-btn" onclick="setPersona(document.querySelector('[data-persona=vendor]')); quickSend('Pak, harga bahan naik 5rb/kg minggu depan')">🏭 Vendor</button>
        <button class="qt-btn" onclick="quickSend('koreksi: harga sandal sekarang 70rb bukan 50rb')">🧠 Koreksi AI</button>
        <button class="qt-btn" onclick="quickSend('info: tersedia Sepatu Premium baru harga 350rb')">📝 Tambah Info</button>
      </div>
    </div>

    <div>
      <h3>📋 Agen Terdaftar</h3>
      <div class="agent-list" id="agent-list">
        <div class="agent-item"><span style="color:#666">Memuat...</span></div>
      </div>
    </div>
  </div>

  <!-- Chat Area -->
  <div class="chat-area">
    <div class="chat-header">
      <h2>🧪 Sandbox Chat</h2>
      <div>
        <span class="ch-badge" id="persona-badge">👤 Pelanggan</span>
        <button class="btn-reset" onclick="resetChat()" style="margin-left:8px;">🗑️ Reset</button>
      </div>
    </div>

    <div class="chat-messages" id="chat-messages">
      <div class="welcome-screen" id="welcome-screen">
        <span class="emoji">🧪</span>
        <h3>AI Sandbox — Ruang Latihan</h3>
        <p>Simulasikan percakapan dengan AI tanpa mengirim pesan ke WhatsApp. Pilih persona di kiri, lalu mulai chat!</p>
      </div>
    </div>

    <div class="typing-indicator" id="typing-indicator">
      <div class="msg-avatar" style="background:rgba(52,211,153,0.2);">🤖</div>
      <div class="msg-bubble" style="background:rgba(255,255,255,0.06); padding:12px 16px;">
        <div class="dots"><span></span><span></span><span></span></div>
      </div>
    </div>

    <div class="chat-input-area">
      <input type="text" class="chat-input" id="chat-input"
        placeholder="Ketik pesan simulasi..." 
        onkeydown="if(event.key==='Enter')sendMessage()" />
      <button class="btn-send" id="btn-send" onclick="sendMessage()">Kirim ➤</button>
    </div>
  </div>
</div>

<script>
let currentPersona = 'customer';
const personaEmoji = { customer: '👤', vendor: '🏭', owner: '👔' };
const personaLabel = { customer: 'Pelanggan', vendor: 'Vendor', owner: 'Owner' };

function setPersona(el) {
  document.querySelectorAll('.persona-btn').forEach(b => b.classList.remove('active'));
  el.classList.add('active');
  currentPersona = el.dataset.persona;
  document.getElementById('persona-badge').innerHTML = personaEmoji[currentPersona] + ' ' + personaLabel[currentPersona];
}

function quickSend(msg) {
  document.getElementById('chat-input').value = msg;
  sendMessage();
}

async function sendMessage() {
  const input = document.getElementById('chat-input');
  const msg = input.value.trim();
  if (!msg) return;
  input.value = '';

  // Hide welcome
  const welcome = document.getElementById('welcome-screen');
  if (welcome) welcome.style.display = 'none';

  // Add user message
  addMessage('user', msg);

  // Show typing
  const typing = document.getElementById('typing-indicator');
  typing.classList.add('active');
  document.getElementById('btn-send').disabled = true;

  const chatBox = document.getElementById('chat-messages');
  chatBox.scrollTop = chatBox.scrollHeight;

  try {
    const res = await fetch('/api/sandbox', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: msg, persona: currentPersona, sessionId: 'sandbox-main' })
    });
    const json = await res.json();

    typing.classList.remove('active');
    document.getElementById('btn-send').disabled = false;

    if (json.success) {
      addMessage('bot', json.data.response, json.data.metadata, json.data.specialAction);
    } else {
      addMessage('bot', '❌ Error: ' + json.error);
    }
  } catch (err) {
    typing.classList.remove('active');
    document.getElementById('btn-send').disabled = false;
    addMessage('bot', '❌ Koneksi gagal: ' + err.message);
  }
}

function addMessage(role, text, metadata, specialAction) {
  const chatBox = document.getElementById('chat-messages');
  const row = document.createElement('div');
  row.className = 'msg-row ' + role;

  const avatarEmoji = role === 'user' ? personaEmoji[currentPersona] : '🤖';

  let metaHtml = '';
  if (metadata) {
    metaHtml = `<div class="msg-meta">
      <span class="meta-tag time">⏱️ ${metadata.elapsed}</span>
    </div>`;
  }

  if (specialAction) {
    const actionType = specialAction.type || 'UNKNOWN';
    metaHtml += `<div class="msg-meta" style="margin-top:4px;">
      <span class="meta-tag" style="background:rgba(251,191,36,0.15); color:#fbbf24;">⚡ ${actionType}</span>
    </div>`;
  }

  row.innerHTML = `
    <div class="msg-avatar">${avatarEmoji}</div>
    <div class="msg-content">
      <div class="msg-bubble">${escapeHtml(text)}</div>
      ${metaHtml}
    </div>
  `;

  chatBox.appendChild(row);
  chatBox.scrollTop = chatBox.scrollHeight;
}

function escapeHtml(t) {
  return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>');
}

async function resetChat() {
  try {
    await fetch('/api/sandbox/reset', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ sessionId: 'sandbox-main' })
    });
  } catch(e) {}
  const chatBox = document.getElementById('chat-messages');
  chatBox.innerHTML = `<div class="welcome-screen" id="welcome-screen">
    <span class="emoji">🧪</span><h3>AI Sandbox — Ruang Latihan</h3>
    <p>Chat di-reset! Mulai percakapan baru.</p></div>`;
}

// Load agent list
async function loadAgents() {
  try {
    const res = await fetch('/api/sandbox/agents');
    const json = await res.json();
    if (json.success) {
      const list = document.getElementById('agent-list');
      list.innerHTML = json.data.map(a => `
        <div class="agent-item">
          <span class="a-name">${a.name} <span style="color:#555">(${a.id})</span></span>
          <span class="a-badge">${a.complexity}</span>
        </div>
      `).join('');
    }
  } catch(e) {}
}
loadAgents();
</script>
