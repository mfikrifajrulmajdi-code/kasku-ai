<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= storeName %> — Flagship E-Commerce Catalog</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #6366f1;
            --primary-glow: rgba(99, 102, 241, 0.4);
            --accent: #ec4899;
            --accent-glow: rgba(236, 72, 153, 0.4);
            --bg-dark: #07090e;
            --bg-card: rgba(18, 24, 38, 0.75);
            --bg-card-hover: rgba(26, 35, 56, 0.9);
            --border-glass: rgba(255, 255, 255, 0.1);
            --border-glow: rgba(99, 102, 241, 0.3);
            --text-main: #f8fafc;
            --text-sub: #94a3b8;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #07090e;
            background-image: 
                radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.15) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(236, 72, 153, 0.12) 0px, transparent 50%),
                radial-gradient(at 50% 50%, rgba(15, 23, 42, 0.5) 0px, transparent 100%);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Floating Navbar */
        .navbar {
            position: sticky;
            top: 16px;
            z-index: 100;
            max-width: 1200px;
            width: 92%;
            margin: 16px auto 0;
            padding: 14px 24px;
            background: rgba(15, 23, 42, 0.7);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--border-glass);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .nav-logo {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            box-shadow: 0 4px 15px var(--primary-glow);
        }

        .nav-title {
            font-family: 'Outfit', sans-serif;
            font-size: 1.35rem;
            font-weight: 800;
            background: linear-gradient(135deg, #fff 0%, #cbd5e1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -0.5px;
        }

        .nav-status {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.3);
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 0.82rem;
            font-weight: 600;
            color: #34d399;
        }

        .status-pulse {
            width: 8px;
            height: 8px;
            background: #34d399;
            border-radius: 50%;
            box-shadow: 0 0 10px #34d399;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(52, 211, 153, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(52, 211, 153, 0); }
        }

        /* Hero Banner */
        .hero-banner {
            max-width: 1200px;
            width: 92%;
            margin: 2rem auto 1.5rem;
            padding: 3.5rem 2rem;
            text-align: center;
            background: radial-gradient(circle at 50% 0%, rgba(99, 102, 241, 0.25), transparent 70%);
            border-radius: 32px;
            border: 1px solid var(--border-glass);
            position: relative;
            overflow: hidden;
        }

        .hero-title {
            font-family: 'Outfit', sans-serif;
            font-size: 3.2rem;
            font-weight: 900;
            letter-spacing: -1.5px;
            line-height: 1.1;
            margin-bottom: 1rem;
            background: linear-gradient(135deg, #ffffff 0%, #a5b4fc 50%, #f472b6 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-subtitle {
            color: var(--text-sub);
            font-size: 1.15rem;
            max-width: 650px;
            margin: 0 auto 2rem;
            line-height: 1.6;
        }

        .hero-stats {
            display: flex;
            justify-content: center;
            gap: 2.5rem;
            flex-wrap: wrap;
        }

        .stat-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            color: #cbd5e1;
        }

        .stat-icon { font-size: 1.2rem; }

        /* Search & Filter Section */
        .search-filter-section {
            max-width: 1200px;
            width: 92%;
            margin: 0 auto 2.5rem;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .search-box-wrap {
            position: relative;
            width: 100%;
        }

        .search-input-field {
            width: 100%;
            padding: 18px 24px 18px 56px;
            background: rgba(18, 24, 38, 0.85);
            border: 1px solid var(--border-glass);
            border-radius: 20px;
            color: #fff;
            font-size: 1.05rem;
            font-family: 'Plus Jakarta Sans', sans-serif;
            outline: none;
            backdrop-filter: blur(16px);
            transition: all 0.3s ease;
            box-shadow: 0 8px 25px rgba(0,0,0,0.3);
        }

        .search-input-field:focus {
            border-color: var(--primary);
            box-shadow: 0 0 30px var(--primary-glow);
        }

        .search-input-icon {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 1.3rem;
            color: var(--text-sub);
        }

        .filter-pills-bar {
            display: flex;
            gap: 10px;
            overflow-x: auto;
            padding-bottom: 6px;
            scrollbar-width: none;
        }

        .filter-pill {
            padding: 10px 22px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-glass);
            border-radius: 30px;
            color: var(--text-sub);
            font-size: 0.92rem;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.3s ease;
        }

        .filter-pill:hover {
            background: rgba(99, 102, 241, 0.15);
            color: #a5b4fc;
            border-color: var(--border-glow);
        }

        .filter-pill.active {
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: #fff;
            border-color: transparent;
            box-shadow: 0 4px 20px var(--accent-glow);
        }

        /* Products Grid */
        .products-grid-container {
            max-width: 1200px;
            width: 92%;
            margin: 0 auto 4rem;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 2rem;
        }

        .product-card-item {
            background: var(--bg-card);
            border: 1px solid var(--border-glass);
            border-radius: 28px;
            padding: 1.25rem;
            backdrop-filter: blur(20px);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
        }

        .product-card-item:hover {
            transform: translateY(-10px);
            background: var(--bg-card-hover);
            border-color: var(--border-glow);
            box-shadow: 0 25px 50px rgba(0,0,0,0.6), 0 0 35px var(--primary-glow);
        }

        .card-media-box {
            width: 100%;
            height: 240px;
            border-radius: 20px;
            overflow: hidden;
            position: relative;
            background: #0b0f19;
            margin-bottom: 1.25rem;
            cursor: pointer;
        }

        .card-media-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .product-card-item:hover .card-media-img {
            transform: scale(1.08);
        }

        .card-media-video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .card-badge {
            position: absolute;
            top: 14px;
            right: 14px;
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 0.75rem;
            font-weight: 700;
            backdrop-filter: blur(10px);
            z-index: 5;
        }

        .badge-in-stock { background: rgba(16, 185, 129, 0.25); color: #34d399; border: 1px solid rgba(52, 211, 153, 0.4); }
        .badge-out-stock { background: rgba(239, 68, 68, 0.25); color: #f87171; border: 1px solid rgba(248, 113, 113, 0.4); }
        .badge-video-tag { position: absolute; top: 14px; left: 14px; background: rgba(236, 72, 153, 0.3); color: #f472b6; border: 1px solid rgba(244, 114, 182, 0.4); }

        .card-details {
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .card-category-tag {
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #818cf8;
            margin-bottom: 6px;
        }

        .card-item-name {
            font-family: 'Outfit', sans-serif;
            font-size: 1.3rem;
            font-weight: 700;
            margin-bottom: 10px;
            line-height: 1.3;
        }

        .card-price-tag {
            font-size: 1.4rem;
            font-weight: 800;
            color: #f472b6;
            margin-bottom: 1.25rem;
        }

        .btn-order-wa {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: #fff;
            text-decoration: none;
            border-radius: 16px;
            font-weight: 700;
            font-size: 0.98rem;
            transition: all 0.3s ease;
            box-shadow: 0 8px 25px var(--accent-glow);
            margin-top: auto;
            border: none;
            cursor: pointer;
        }

        .btn-order-wa:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 35px var(--accent-glow);
        }

        .btn-order-wa.disabled {
            background: rgba(71, 85, 105, 0.4);
            box-shadow: none;
            cursor: not-allowed;
            color: #64748b;
        }

        /* Lightbox Modal */
        .modal-backdrop {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0, 0, 0, 0.88);
            backdrop-filter: blur(16px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            padding: 24px;
        }

        .modal-backdrop.active { display: flex; }

        .modal-box {
            background: #111827;
            border: 1px solid var(--border-glass);
            border-radius: 32px;
            max-width: 650px;
            width: 100%;
            padding: 28px;
            position: relative;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.8);
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .modal-close-btn {
            position: absolute;
            top: 20px; right: 20px;
            background: rgba(255, 255, 255, 0.1);
            border: none;
            color: #fff;
            width: 40px; height: 40px;
            border-radius: 50%;
            font-size: 1.2rem;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
        }

        .modal-media-wrap {
            width: 100%;
            max-height: 380px;
            border-radius: 20px;
            overflow: hidden;
            background: #07090e;
            display: flex; align-items: center; justify-content: center;
        }

        .modal-media-wrap img, .modal-media-wrap video {
            width: 100%; height: 100%; object-fit: contain;
        }

        /* Footer */
        .page-footer {
            margin-top: auto;
            padding: 2.5rem 1rem;
            text-align: center;
            color: var(--text-sub);
            font-size: 0.88rem;
            border-top: 1px solid var(--border-glass);
        }

        @media (max-width: 768px) {
            .hero-title { font-size: 2.3rem; }
            .hero-stats { gap: 1rem; }
            .navbar { padding: 12px 18px; }
        }
    </style>
</head>
<body>

    <!-- Floating Navbar -->
    <nav class="navbar">
        <a href="/" class="nav-brand">
            <div class="nav-logo">🛍️</div>
            <span class="nav-title"><%= storeName %></span>
        </a>
        <div class="nav-status">
            <span class="status-pulse"></span>
            <span><%= storeName %> AI Online 24/7</span>
        </div>
    </nav>

    <!-- Hero Banner -->
    <header class="hero-banner">
        <h1 class="hero-title">Koleksi Eksklusif <%= storeName %></h1>
        <p class="hero-subtitle">Nikmati pengalaman belanja modern dengan layanan konsultasi AI Bima & Kasir Citra secara instan di WhatsApp.</p>
        
        <!-- Indonesian Lifestyle Lookbook Gallery -->
        <div style="display: flex; gap: 20px; justify-content: center; margin: 2rem auto 2.5rem; max-width: 900px; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 280px; height: 220px; border-radius: 24px; overflow: hidden; border: 1px solid rgba(255,255,255,0.15); box-shadow: 0 10px 30px rgba(0,0,0,0.5); position: relative;">
                <img src="/images/lifestyle_1.jpg" alt="<%= storeName %> Urban Lifestyle" style="width: 100%; height: 100%; object-fit: cover;">
                <div style="position: absolute; bottom: 12px; left: 14px; background: rgba(0,0,0,0.65); backdrop-filter: blur(10px); padding: 6px 14px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; color: #fff;">🇮🇩 Indonesian Urban Streetwear</div>
            </div>
            <div style="flex: 1; min-width: 280px; height: 220px; border-radius: 24px; overflow: hidden; border: 1px solid rgba(255,255,255,0.15); box-shadow: 0 10px 30px rgba(0,0,0,0.5); position: relative;">
                <img src="/images/lifestyle_2.jpg" alt="<%= storeName %> Luxury Craftsmanship" style="width: 100%; height: 100%; object-fit: cover;">
                <div style="position: absolute; bottom: 12px; left: 14px; background: rgba(0,0,0,0.65); backdrop-filter: blur(10px); padding: 6px 14px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; color: #fff;">✨ Handmade Leather Craftsmanship</div>
            </div>
        </div>

        <div class="hero-stats">
            <div class="stat-item"><span class="stat-icon">⚡</span> AI Order Real-Time</div>
            <div class="stat-item"><span class="stat-icon">💳</span> Bayar QRIS / Midtrans</div>
            <div class="stat-item"><span class="stat-icon">🛡️</span> 100% Produk Garansi Resmi</div>
        </div>
    </header>


    <!-- Search & Filter Controls -->
    <section class="search-filter-section">
        <div class="search-box-wrap">
            <span class="search-input-icon">🔍</span>
            <input type="text" class="search-input-field" id="search-input" placeholder="Cari berdasarkan nama barang, SKU, atau kategori..." oninput="filterProducts()">
        </div>
        <div class="filter-pills-bar">
            <button class="filter-pill active" onclick="filterCategory('all', this)">🌐 Semua Produk</button>
            <button class="filter-pill" onclick="filterCategory('Sepatu', this)">👟 Sepatu</button>
            <button class="filter-pill" onclick="filterCategory('Sandal', this)">🩴 Sandal</button>
            <button class="filter-pill" onclick="filterCategory('Pakaian', this)">👕 Pakaian</button>
            <button class="filter-pill" onclick="filterCategory('Aksesoris', this)">🎒 Aksesoris</button>
        </div>
    </section>

    <!-- Products Grid -->
    <main class="products-grid-container" id="products-grid">
        <% if (items && items.length > 0) { %>
            <% items.forEach((item) => { %>
                <article class="product-card-item" data-nama="<%= item.nama.toLowerCase() %>" data-sku="<%= (item.sku || '').toLowerCase() %>" data-kategori="<%= item.kategori %>">
                    
                    <!-- Badges -->
                    <% if (item.stok === '0') { %>
                        <div class="card-badge badge-out-stock">Stok Habis 🚨</div>
                    <% } else { %>
                        <div class="card-badge badge-in-stock">Stok: <%= item.stok %></div>
                    <% } %>

                    <% if (item.video) { %>
                        <div class="card-badge badge-video-tag">🎥 Video Demo</div>
                    <% } %>

                    <!-- Media Container -->
                    <div class="card-media-box" onclick="openModal('<%= encodeURIComponent(item.nama) %>', 'Rp <%= item.harga %>', '<%= item.gambar %>', '<%= item.video %>', '<%= item.stok %>')">
                        <% if (item.video) { %>
                            <video class="card-media-video" autoplay loop muted playsinline src="<%= item.video %>"></video>
                        <% } else if (item.gambar) { %>
                            <img class="card-media-img" src="<%= item.gambar %>" alt="<%= item.nama %>" loading="lazy">
                        <% } else { %>
                            <div style="font-size: 3.5rem; display:flex; align-items:center; justify-content:center; height:100%;">🛍️</div>
                        <% } %>
                    </div>

                    <!-- Details -->
                    <div class="card-details">
                        <span class="card-category-tag"><%= item.kategori %> <%= item.sku ? '• SKU: ' + item.sku : '' %></span>
                        <h2 class="card-item-name"><%= item.nama %></h2>
                        <div class="card-price-tag">Rp <%= item.harga %></div>
                        
                        <% if (item.stok === '0') { %>
                            <button class="btn-order-wa disabled" disabled>🚫 Stok Habis</button>
                        <% } else { %>
                            <a href="https://wa.me/<%= waNumber %>?text=Halo%20Bima,%20saya%20mau%20pesan%20<%= encodeURIComponent(item.nama) %>" class="btn-order-wa" target="_blank">
                                💬 Pesan via WhatsApp
                            </a>
                        <% } %>
                    </div>
                </article>
            <% }) %>
        <% } else { %>
            <div style="text-align: center; color: var(--text-sub); grid-column: 1 / -1; padding: 4rem 0;">
                <span style="font-size: 3.5rem;">📦</span>
                <h3 style="margin-top: 1rem;">Belum ada data produk di Google Sheets.</h3>
                <p>Tambahkan daftar barang di Google Sheets untuk menampilkannya di sini secara otomatis.</p>
            </div>
        <% } %>
    </main>

    <!-- Lightbox Modal -->
    <div class="modal-backdrop" id="preview-modal" onclick="closeModal(event)">
        <div class="modal-box" onclick="event.stopPropagation()">
            <button class="modal-close-btn" onclick="closeModal()">✕</button>
            <div class="modal-media-wrap" id="modal-media-box"></div>
            <div>
                <span id="modal-sku" style="font-size: 0.8rem; font-weight: 700; color: var(--primary);"></span>
                <h2 id="modal-title" style="margin: 6px 0 10px; font-family: 'Outfit', sans-serif; font-size: 1.6rem;"></h2>
                <div id="modal-price" style="font-size: 1.5rem; color: #f472b6; font-weight: 800; margin-bottom: 20px;"></div>
                <a id="modal-wa-btn" href="#" class="btn-order-wa" target="_blank">💬 Pesan via WhatsApp Sekarang</a>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="page-footer">
        <p>© 2026 <%= storeName %> — Ditenagai oleh KasKu Agentic AI Multi-Agent System v2.0</p>
    </footer>

    <script>
        let currentCategory = 'all';

        function filterCategory(cat, el) {
            currentCategory = cat;
            document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
            el.classList.add('active');
            filterProducts();
        }

        function filterProducts() {
            const query = document.getElementById('search-input').value.toLowerCase().trim();
            const cards = document.querySelectorAll('.product-card-item');

            cards.forEach(card => {
                const nama = card.dataset.nama || '';
                const sku = card.dataset.sku || '';
                const kategori = card.dataset.kategori || '';

                const matchesSearch = !query || nama.includes(query) || sku.includes(query) || kategori.toLowerCase().includes(query);
                const matchesCat = currentCategory === 'all' || kategori === currentCategory;

                if (matchesSearch && matchesCat) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function openModal(namaEnc, harga, gambar, video, stok) {
            const nama = decodeURIComponent(namaEnc);
            document.getElementById('modal-title').innerText = nama;
            document.getElementById('modal-price').innerText = harga;

            const mediaBox = document.getElementById('modal-media-box');
            if (video && video !== 'undefined') {
                mediaBox.innerHTML = `<video controls autoplay loop muted playsinline src="${video}"></video>`;
            } else if (gambar && gambar !== 'undefined') {
                mediaBox.innerHTML = `<img src="${gambar}" alt="${nama}">`;
            } else {
                mediaBox.innerHTML = `<div style="font-size:4rem;">🛍️</div>`;
            }

            const waBtn = document.getElementById('modal-wa-btn');
            if (stok === '0') {
                waBtn.innerText = '🚫 Stok Habis';
                waBtn.classList.add('disabled');
                waBtn.href = '#';
            } else {
                waBtn.innerText = '💬 Pesan via WhatsApp Sekarang';
                waBtn.classList.remove('disabled');
                waBtn.href = `https://wa.me/<%= waNumber %>?text=Halo%20Bima,%20saya%20mau%20pesan%20${encodeURIComponent(nama)}`;
            }

            document.getElementById('preview-modal').classList.add('active');
        }

        function closeModal(e) {
            if (!e || e.target.classList.contains('modal-backdrop') || e.target.classList.contains('modal-close-btn')) {
                document.getElementById('preview-modal').classList.remove('active');
                document.getElementById('modal-media-box').innerHTML = '';
            }
        }
    </script>
</body>
</html>
